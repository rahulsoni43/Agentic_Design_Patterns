# Sherlock SRE Configuration

# AI/ML
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Slack
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_CHANNEL=#incidents  # Default channel for alerts

# Kubernetes
# Leave empty to use in-cluster config or default kubeconfig
KUBECONFIG_PATH=

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sherlock
POSTGRES_USER=sherlock
POSTGRES_PASSWORD=your-password-here

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Vector Database (Weaviate)
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=

# Monitoring Sources
# Prometheus
PROMETHEUS_URL=http://localhost:9090

# Elasticsearch
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USER=
ELASTICSEARCH_PASSWORD=

# Cloud Providers (optional)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

GCP_PROJECT_ID=
GCP_CREDENTIALS_PATH=

# Application Settings
LOG_LEVEL=INFO
ENVIRONMENT=development  # development, staging, production

# Features
ENABLE_AUTO_REMEDIATION=false  # Safety first!
ENABLE_PREDICTIVE_ALERTS=true
ENABLE_INCIDENT_LEARNING=true
